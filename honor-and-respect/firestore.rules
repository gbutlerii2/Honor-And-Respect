rules_version = '2';

// Honor and Respect — Firestore security rules
// Roles live in users/{uid}.role: contributor | editor | admin (signed-out visitors are readers).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function roleIn(roles) { return hasProfile() && profile().role in roles; }
    // Owner account: always allowed to hold the admin role. Keep in step with OWNER_EMAIL in js/firebase-config.js.
    function isOwner() { return signedIn() && request.auth.token.email == 'gbutlerii@honor-and-respect.com'; }
    function isContributor() { return roleIn(['contributor', 'editor', 'admin']); }
    function isEditor() { return roleIn(['editor', 'admin']); }
    function isAdmin() { return roleIn(['admin']); }

    // Public register: anyone can read; editors write; admins delete.
    match /memorials/{id} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Revision log + suggestion queue.
    match /revisions/{revId} {
      allow read: if true;
      allow create: if isContributor()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.memorialId is string
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'published' && isEditor()));
      // Editors approve or reject; only the review fields may change.
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['published', 'rejected'];
      allow delete: if isAdmin();
    }

    // User profiles. New users may only create themselves as contributor
    // and can never change their own role. Admins manage everyone.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if (signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'contributor'
            || (isOwner() && request.resource.data.role == 'admin')))
        || isAdmin();
      allow update: if (signedIn() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || (isOwner() && request.auth.uid == uid && request.resource.data.role == 'admin')
        || isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Remembrances & stories: anyone may post without an account. The poster's
    // email goes in remembranceContacts (same doc ID), which only editors and
    // admins can read, so it is never public. A new post starts "unconfirmed"
    // (hidden); the confirmRemembrance Cloud Function emails the poster a link
    // and publishes it when they click (or queues it as "pending" if an admin
    // has turned on settings/remembrances.requireApproval). Editors and admins
    // signed in to the site can publish directly.
    match /remembrances/{rid} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create: if request.resource.data.keys().hasOnly(['memorialId', 'name', 'relationship', 'body', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['memorialId', 'name', 'body', 'status', 'createdAt'])
        && request.resource.data.memorialId is string
        && request.resource.data.memorialId.size() > 0 && request.resource.data.memorialId.size() <= 200
        && exists(/databases/$(database)/documents/memorials/$(request.resource.data.memorialId))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && (!('relationship' in request.resource.data)
            || (request.resource.data.relationship is string && request.resource.data.relationship.size() <= 40))
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 3000
        && request.resource.data.createdAt == request.time
        && (request.resource.data.status == 'unconfirmed'
            || (request.resource.data.status == 'published' && isEditor()))
        && existsAfter(/databases/$(database)/documents/remembranceContacts/$(rid));
      // Editors approve or hide; only the moderation fields may change.
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['pending', 'published', 'hidden'];
      allow delete: if isAdmin();
    }
    match /remembranceContacts/{rid} {
      allow read: if isEditor();
      allow create: if request.resource.data.keys().hasOnly(['email', 'memorialId', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/remembrances/$(rid))
        && getAfter(/databases/$(database)/documents/remembrances/$(rid)).data.memorialId == request.resource.data.memorialId;
      allow delete: if isAdmin();
    }
    // Confirmation tokens: Cloud Functions only.
    match /remembranceTokens/{rid} { allow read, write: if false; }

    // Activity log: admins read it; signed-in users append entries about their
    // own actions; Cloud Functions log public posts. Entries are never edited.
    match /activity/{aid} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 500;
      allow update, delete: if false;
    }

    // Site settings (public read so the app and rules can check them).
    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // QR plaque registry (printed codes).
    match /qrCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
